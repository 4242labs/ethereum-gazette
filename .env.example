# Backend / API environment (Vercel Functions)
# Copy to .env.local and fill in your own values.

# PostgreSQL / Supabase connection string.
# Use the Session Pooler URL (port 6543/5432) for serverless/IPv4 compatibility.
POSTGRES_URL=postgresql://user:password@host:6543/postgres

# Shared secret protecting the manual ingestion / admin endpoints.
ADMIN_KEY=change_me

# Secret required by the scheduled cron ingestion endpoint (Vercel Cron).
CRON_SECRET=change_me

# Optional on-chain data providers (free tiers are sufficient).
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=
