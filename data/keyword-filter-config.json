  "contextualRules": {
    "comparisonBidirectional": {
      "description": "Ethereum compared to/against competitors or vice versa — indicates substantive analysis, push toward review",
      "pattern": "(?:(?:ethereum|eth)\\s+(?:vs|versus|compared to|against)\\s+(?:bitcoin|solana|cardano|avalanche))|(?:(?:bitcoin|solana|cardano|avalanche)\\s+(?:vs|versus|compared to|against)\\s+(?:ethereum|eth))|(?:which\\s+(?:is\\s+)?(?:better|best).*(?:ethereum|bitcoin|solana|cardano))",
      "weightModifier": 1.0
    },
    "competitorDominance": {
      "description": "Competitor surpasses/beats/outperforms Ethereum — strong negative signal",
      "pattern": "(?:solana|bitcoin|cardano|avalanche).*(?:surpass|surpasses|beat|beats|exceed|exceeds|outperform|outperforms).*ethereum",
      "weightModifier": -5.0
    },
    "migrateFromEthereum": {
      "description": "Migration/exodus away from Ethereum to competitors — reject signal",
      "pattern": "(?:(?:migrat|mov|switch|leav|abandon).*(?:from|away from).*ethereum.*(?:to\\s|seeking|for))|(?:ethereum.*(?:developers|users).*(?:migrat|mov|switch|leav|abandon).*(?:seeking|for|to))",
      "weightModifier": -5.0
    },
    "migrateToEthereum": {
      "description": "Migration TO Ethereum — strong positive signal",
      "pattern": "(?:migrat|mov|switch).*(?:to|into)\\s+ethereum",
      "weightModifier": 0.8
    },
    "integration": {
      "description": "Integration with Ethereum is relevant even if mentioning other chains",
      "pattern": "integrat.*ethereum|ethereum\\s+integrat",
      "weightModifier": 0.6
    },
    "ethereumNegativeContext": {
      "description": "Ethereum mentioned primarily in negative context",
      "pattern": "ethereum.*(?:slow|expensive|problem|issue|fail|struggling|losing)",
      "weightModifier": -3.0
    }
  },
  "exclusionPatterns": {
    "description": "Patterns that should be automatically rejected regardless of keyword score",
    "patterns": [
      "bitcoin price prediction",
      "crypto trading signals",
      "investment advice",
      "not financial advice",
      "pump and dump"
    ]
  },
  "notes": {
    "usage": "This configuration supports Method 3 Phase 2 keyword heuristics filtering for Tier 2 RSS sources",
    "scoring": "Final score = sum(keyword_weight * context_weight * frequency) + proximity_bonus + contextual_rule_modifiers",
    "thresholds": "autoApprove >= 1.2, autoReject <= -0.5, everything else goes to review queue",
    "maintenance": "Keywords should be reviewed monthly and updated based on ecosystem evolution",
    "testing": "Use /api/test/keyword-filter endpoint to validate changes before deployment"
  }
